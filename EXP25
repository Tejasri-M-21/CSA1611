marks <- c(55,60,71,63,55,65,50,55,58,

             59,61,63,65,67,71,72,75)

marks.sorted <- sort(marks)

cat("Sorted marks:\n")

print(marks.sorted)

cat("\nEqual-frequency bins:\n")

print(split(marks.sorted,

            rep(1:3, length.out=length(marks))))

breaks <- seq(min(marks),max(marks),length.out=4)

cat("\nEqual-width intervals:\n")

print(breaks)

set.seed(1)

km <- kmeans(matrix(marks), centers=3, nstart=20)

cat("\nK-Means cluster centers:\n")

print(sort(km$centers[,1]))

hist(marks, breaks=breaks,

     main="Marks Histogram",

     xlab="Marks", col="lightblue")

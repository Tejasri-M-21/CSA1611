classA <- c(76,35,47,64,95,66,89,36,84)

classB <- c(51,56,84,60,59,70,63,66,50)

cat("Class A\n")

cat("Mean   :", mean(classA), "\n")

cat("Median :", median(classA), "\n")

cat("Range  :", diff(range(classA)), "\n")

cat("\nClass B\n")

cat("Mean   :", mean(classB), "\n")

cat("Median :", median(classB), "\n")

cat("Range  :", diff(range(classB)), "\n")

boxplot(classA, classB, names=c("Class A","Class B"),

        main="Class A vs Class B", ylab="Marks")

age <- c(13,15,16,16,19,20,20,21,22,22,25,25,25,25,

           30,33,33,35,35,35,35,36,40,45,46,52,70)

frequency <- table(age)

cat("Frequency table:\n")

print(frequency)

cat("\nMean =",mean(age),"\n")

cat("Median =",median(age),"\n")

cat("Minimum =",min(age),"\n")

cat("Maximum =",max(age),"\n")

cat("Midrange =",(min(age)+max(age))/2,"\n")

quartiles <- quantile(age,c(0.25,0.50,0.75))

cat("\nQuartiles:\n")

print(quartiles)

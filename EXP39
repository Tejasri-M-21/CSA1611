library(e1071)

data(iris)

set.seed(20)

id <- sample(1:nrow(iris), 0.7*nrow(iris))

train <- iris[id,]

test <- iris[-id,]

nb <- naiveBayes(Species~.,train)

sv <- svm(Species~.,train)

p1 <- predict(nb,test)

p2 <- predict(sv,test)

acc1 <- mean(p1==test$Species)

acc2 <- mean(p2==test$Species)

result <- data.frame(

 Algorithm=c("Naive Bayes","SVM"),

 Accuracy=c(acc1,acc2)

)

print(result)

barplot(result$Accuracy,

        names.arg=result$Algorithm,

        ylim=c(0,1),

        main="Accuracy Comparison",

        ylab="Accuracy")

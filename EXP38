employee <- data.frame(

 EmployeeID=c(111,222,333,444,555,666),

 Age=c(28,25,26,25,30,29),

 Salary=c(150000,150000,160000,160000,170000,200000),

 Credit=c(39,27,42,40,64,72)

)

for(k in c(2,3,4)) {

  set.seed(10)

  km <- kmeans(employee[,2:4], centers=k, nstart=20)

  cat("\nNumber of clusters =",k,"\n")

  print(km$centers)

}

set.seed(10)

km <- kmeans(employee[,2:4], centers=3, nstart=20)

plot(employee$Salary, employee$Credit,

     col=km$cluster, pch=19,

     main="K-Means Visualization",

     xlab="Salary", ylab="Credit")

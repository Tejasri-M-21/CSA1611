age <- c(13,15,16,16,19,20,20,21,22,22,25,25,25,25,

           30,33,33,35,35,35,35,36,40,45,46,52,70)

freq <- table(age)

modes <- names(freq[freq==max(freq)])

statistics <- list(

 Mean=mean(age),

 Median=median(age),

 Mode=modes,

 Midrange=(min(age)+max(age))/2,

 Q1=quantile(age,0.25),

 Q3=quantile(age,0.75)

)

print(statistics)

employee <- data.frame(

 EmployeeID=c(111,222,333,444,555,666),

 Gender=c("Male","Male","Female","Female","Female","Male"),

 Age=c(28,25,26,25,30,29),

 Salary=c(150000,150000,160000,160000,170000,200000),

 Credit=c(39,27,42,40,64,72)

)

set.seed(123)

km <- kmeans(employee[,c("Age","Salary","Credit")],

             centers=3, nstart=20)

employee$Cluster <- km$cluster

print(employee)

print(km$centers)

plot(employee$Salary, employee$Credit,

     col=employee$Cluster, pch=19,

     main="Employee K-Means Clusters",

     xlab="Salary", ylab="Credit")

points <- c(18,22,25,27,29,30,31,32,33,35,36,38,40,42,75)

boxplot(points,

        main="Tennis Player Scores",

        ylab="Points Scored",

        col="lightblue",

        pch=19)

Q1 <- quantile(points,0.25)

Q3 <- quantile(points,0.75)

IQR_value <- IQR(points)

lower <- Q1 - 1.5*IQR_value

upper <- Q3 + 1.5*IQR_value

cat("Q1 =", Q1, "\n")

cat("Q3 =", Q3, "\n")

cat("IQR =", IQR_value, "\n")

cat("Lower limit =", lower, "\n")

cat("Upper limit =", upper, "\n")

cat("Outliers:\n")

print(points[points < lower | points > upper])

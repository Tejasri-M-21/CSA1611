x <- c(11,13,13,15,15,16,19,20,20,20,21,21,

         22,23,24,30,40,45,45,45,71,72,73,75)

bins <- split(x, rep(1:6, each=4))

mean_smooth <- unlist(lapply(bins, function(b)

  rep(mean(b), length(b))))

median_smooth <- unlist(lapply(bins, function(b)

  rep(median(b), length(b))))

boundary_smooth <- unlist(lapply(bins, function(b)

  sapply(b, function(v) {

    if(abs(v-min(b)) <= abs(v-max(b)))

      min(b)

    else

      max(b)

  })))

cat("Original bins:\n")

print(bins)

cat("\nMean smoothing:\n")

print(mean_smooth)

cat("\nMedian smoothing:\n")

print(median_smooth)

cat("\nBoundary smoothing:\n")

print(boundary_smooth)

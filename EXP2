price <- c(1,1,5,5,5,5,5,8,8,10,10,10,10,12,14,14,14,

15,15,15,15,15,15,18,18,18,18,18,20,20,20,20,20,20,

21,21,21,21,25,25,25,25,25,28,28,30)

n <- length(price)

bins <- split(sort(price), rep(1:3, each=n/3))

mean.smooth <- unlist(lapply(bins, function(b) rep(mean(b), length(b))))

boundary.smooth <- unlist(lapply(bins, function(b)

  sapply(b, function(v)

    if(abs(v-min(b)) <= abs(v-max(b))) min(b) else max(b))))

cat("Equal-frequency bins:\n")

print(bins)

cat("\nBin mean smoothing:\n")

print(mean.smooth)

cat("\nBin boundary smoothing:\n")

print(boundary.smooth)

hist(price, breaks=12, main="All Electronics Prices",

     xlab="Price", col="lightblue")
